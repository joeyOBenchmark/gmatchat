Create ForceModel LEO_GEO_EP_ForceModel;
LEO_GEO_EP_ForceModel.CentralBody = 'Earth';
LEO_GEO_EP_ForceModel.PrimaryBodies = {Earth};
LEO_GEO_EP_ForceModel.PointMasses = {Luna, Sun};
LEO_GEO_EP_ForceModel.ErrorControl = 'RSSStep';
LEO_GEO_EP_ForceModel.SRP = On;
LEO_GEO_EP_ForceModel.RelativisticCorrection = Off;
LEO_GEO_EP_ForceModel.GravityField.Earth.Degree = 8;
LEO_GEO_EP_ForceModel.GravityField.Earth.Order = 8;
LEO_GEO_EP_ForceModel.GravityField.Earth.StmLimit = 100;
LEO_GEO_EP_ForceModel.GravityField.Earth.PotentialFile = 'JGM2.cof';
LEO_GEO_EP_ForceModel.GravityField.Earth.TideModel = 'None';
LEO_GEO_EP_ForceModel.SRP.Flux = 1367.0;
LEO_GEO_EP_ForceModel.SRP.SRPModel = 'Spherical';
LEO_GEO_EP_ForceModel.SRP.Nominal_Sun = 149597870.691;

Create Propagator LEO_GEO_EP_Prop;
LEO_GEO_EP_Prop.FM = 'LEO_GEO_EP_ForceModel';
LEO_GEO_EP_Prop.Type = 'RungeKutta89';
LEO_GEO_EP_Prop.InitialStepSize = 600.0;
LEO_GEO_EP_Prop.Accuracy = 1e-12;
LEO_GEO_EP_Prop.MinStep = 0.0;
LEO_GEO_EP_Prop.MaxStep = 2700.0;
LEO_GEO_EP_Prop.MaxStepAttempts = 50;
LEO_GEO_EP_Prop.StopIfAccuracyIsViolated = On;

Create DifferentialCorrector DefaultDC;
DefaultDC.ShowProgress = On;
DefaultDC.ReportStyle = 'Normal';
DefaultDC.MaximumIterations = 200;
DefaultDC.DerivativeMethod = 'ForwardDifference';
DefaultDC.Algorithm = 'ModifiedBroyden';
DefaultDC.ReportFile = '/workspace/user_analysis/test_analysis3/sim_leo_to_geo_ep/dc_report.data';

Create Yukon Yukon;
Yukon.ShowProgress = On;
Yukon.ReportStyle = 'Normal';
Yukon.MaximumIterations = 1000;
Yukon.UseCentralDifferences = Off;
Yukon.FeasibilityTolerance = 0.0001;
Yukon.HessianUpdateMethod = 'SelfScaledBFGS';
Yukon.MaximumFunctionEvals = 1000;
Yukon.OptimalityTolerance = 0.0001;
Yukon.FunctionTolerance = 0.0001;
Yukon.MaximumElasticWeight = 10000;

Create OrbitView EarthView;
EarthView.SolverIterations = 'Current';
EarthView.UpperLeft = [ 0, 0 ];
EarthView.Size = [ 0.5, 0.5 ];
EarthView.RelativeZOrder = 0;
EarthView.Maximized = Off;
EarthView.Add = {Earth, Luna, Sun, Sat};
EarthView.CoordinateSystem = 'EarthMJ2000Eq';
EarthView.DrawObject = [ true true ];
EarthView.DataCollectFrequency = 1;
EarthView.UpdatePlotFrequency = 50;
EarthView.NumPointsToRedraw = 0;
EarthView.ShowPlot = On;
EarthView.MaxPlotPoints = 20000;
EarthView.ShowLabels = On;
EarthView.ViewPointReference = 'Earth';
EarthView.ViewPointVector = [ 0.0, 0.0, 30000.0 ];
EarthView.ViewDirection = 'Earth';
EarthView.ViewScaleFactor = 4.0;
EarthView.ViewUpCoordinateSystem = 'EarthMJ2000Eq';
EarthView.ViewUpAxis = 'Z';
EarthView.EclipticPlane = Off;
EarthView.XYPlane = On;
EarthView.WireFrame = Off;
EarthView.Axes = On;
EarthView.Grid = Off;
EarthView.SunLine = Off;
EarthView.UseInitialView = On;
EarthView.StarCount = 7000;
EarthView.EnableStars = On;
EarthView.EnableConstellations = Off;

