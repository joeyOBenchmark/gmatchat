EphemerisFile1.FinalEpoch = 'FinalSpacecraftEpoch';
EphemerisFile1.Interpolator = 'Lagrange';
EphemerisFile1.InterpolationOrder = 7;
EphemerisFile1.OutputFormat = 'LittleEndian';
EphemerisFile1.IncludeCovariance = None;
EphemerisFile1.WriteEphemeris = On;
EphemerisFile1.Spacecraft = Sat;

Create ReportFile BurnReport;
BurnReport.SolverIterations = 'Current';
BurnReport.UpperLeft = [ 0, 0 ];
BurnReport.Size = [ 0, 0 ];
BurnReport.RelativeZOrder = 0;
BurnReport.Maximized = Off;
BurnReport.Filename = '/workspace/user_analysis/test_analysis3/sim_leo_to_geo_ep/Sat_BurnReport.csv';
BurnReport.Precision = 16;
BurnReport.WriteHeaders = On;
BurnReport.LeftJustify = On;
BurnReport.ZeroFill = Off;
BurnReport.FixedWidth = On;
BurnReport.Delimiter = ' ';
BurnReport.ColumnWidth = 56;
BurnReport.WriteReport = On;
BurnReport.AppendToExistingFile = Off;


%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------

Create Variable mass_prior_to_burn n_burns impulse_Ns duration_s propused_kg mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b current_radius_km;
Create Variable dt_EP_burn_s start_time_s;
Create String write_msg_1 write_msg_2 burn_description burn_type write_msg_3 write_msg_4 write_msg_5 write_msg_6 write_msg_7 write_msg_8;
Create String write_msg_9 write_msg_10 write_msg_11 write_msg_12 write_msg_13 write_msg_14 write_msg_15 write_msg_16 write_msg_17 write_msg_18;
Create String write_msg_19 write_msg_20 write_msg_21 write_msg_22 write_msg_23 write_msg_24 write_msg_25 write_msg_26 write_msg_27 write_msg_28;

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
Global BurnReport;
GMAT mass_prior_to_burn = Sat.TotalMass;
GMAT n_burns = 0;
% coast(days=0.1)
write_msg_1 = '> Coast: Coast (0.1 days)';
Write write_msg_1;
Propagate 'Coast' LEO_GEO_EP_Prop(Sat) {Sat.ElapsedDays = 0.1};
% report_state(description='Initial LEO 500km')
write_msg_2 = '--- STATE: Initial LEO 500km ---';
Write write_msg_2;
GMAT burn_description = 'Initial LEO 500km';
GMAT burn_type = 'none';
GMAT impulse_Ns = 0;
GMAT duration_s = 0;
GMAT propused_kg = 0;
GMAT mag_burn_kmps = 0;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
GMAT mass_prior_to_burn = Sat.TotalMass;
Report BurnReport burn_description Sat.ElapsedDays Sat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg Sat.TotalMass Sat.Earth.RadPer Sat.Earth.RadApo Sat.Earth.Altitude Sat.EarthMJ2000Eq.INC Sat.EarthMJ2000Eq.RAAN Sat.EarthMJ2000Eq.AOP Sat.Earth.TA Sat.Earth.SMA Sat.Earth.ECC Sat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
% progressive_spiral_raise(target_radius=42164.137)
% Adaptive staging based on orbital mechanics
write_msg_3 = '====== PROGRESSIVE EP SPIRAL RAISE: Target = 42164.137 km ======';
Write write_msg_3;
% report_state(description='EP Spiral LEO to GEO')
write_msg_4 = '--- STATE: EP Spiral LEO to GEO ---';
Write write_msg_4;
GMAT burn_description = 'EP Spiral LEO to GEO';
GMAT burn_type = 'none';
GMAT impulse_Ns = 0;
GMAT duration_s = 0;
GMAT propused_kg = 0;
GMAT mag_burn_kmps = 0;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
GMAT mass_prior_to_burn = Sat.TotalMass;
Report BurnReport burn_description Sat.ElapsedDays Sat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg Sat.TotalMass Sat.Earth.RadPer Sat.Earth.RadApo Sat.Earth.Altitude Sat.EarthMJ2000Eq.INC Sat.EarthMJ2000Eq.RAAN Sat.EarthMJ2000Eq.AOP Sat.Earth.TA Sat.Earth.SMA Sat.Earth.ECC Sat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
GMAT current_radius_km = Sat.Earth.RMAG;
% Calculated 5 stages for 35586 km raise
% Stage 1/5: target=9538 km, tol=32.6 km, period=2.6 hr, pert=0.15 hr
write_msg_5 = '>> Progressive Raise Stage 1/5: Target=9538 km, Tol=32.6 km, Period=2.6 hr';
Write write_msg_5;
% SpiralRaiseManeuver(target_radius=9538.299926021311)
write_msg_6 = '=== EP SPIRAL RAISE: Target radius = 9538.299926021311 km ===';
Write write_msg_6;
% report_state(description='Stage 1/5 (9538 km)')
write_msg_7 = '--- STATE: Stage 1/5 (9538 km) ---';
Write write_msg_7;
GMAT burn_description = 'Stage 1/5 (9538 km)';
GMAT burn_type = 'none';
GMAT impulse_Ns = 0;
GMAT duration_s = 0;
GMAT propused_kg = 0;
GMAT mag_burn_kmps = 0;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
GMAT mass_prior_to_burn = Sat.TotalMass;
Report BurnReport burn_description Sat.ElapsedDays Sat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg Sat.TotalMass Sat.Earth.RadPer Sat.Earth.RadApo Sat.Earth.Altitude Sat.EarthMJ2000Eq.INC Sat.EarthMJ2000Eq.RAAN Sat.EarthMJ2000Eq.AOP Sat.Earth.TA Sat.Earth.SMA Sat.Earth.ECC Sat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
GMAT dt_EP_burn_s = 0;
GMAT start_time_s = Sat.ElapsedSecs;
If Sat.EarthMJ2000Eq.BrouwerShortSMA < 9538.299926021311
   Target 'EP Raise' DefaultDC {SolveMode = Solve, ExitMode = DiscardAndContinue, ShowProgressWindow = true};
      Vary 'Vary Burn Duration' DefaultDC(dt_EP_burn_s = 0, {Perturbation = 530.964336529799, Lower = 0, Upper = 9e+300, MaxStep = 530964.3365297989});
      BeginFiniteBurn 'Turn Thruster On' Sat_electric_fb_v_plus(Sat);
      Propagate 'Prop BurnDuration' LEO_GEO_EP_Prop(Sat) {Sat.ElapsedSecs = dt_EP_burn_s};
      EndFiniteBurn 'Turn Thruster Off' Sat_electric_fb_v_plus(Sat);
      Propagate 'Prop To Apogee' LEO_GEO_EP_Prop(Sat) {Sat.Apoapsis};
      Achieve 'Achieve SMA' DefaultDC(Sat.EarthMJ2000Eq.BrouwerShortSMA = 9538.299926021311, {Tolerance = 32.625837073978694});
   EndTarget;
EndIf;

% _report_finite_burn(description='EP Raise')
write_msg_8 = '*** FINITE BURN: EP Raise ***';
Write write_msg_8;
GMAT burn_description = 'EP Raise';
GMAT burn_type = 'finite';
GMAT impulse_Ns = 0.2 * dt_EP_burn_s;
GMAT n_burns = n_burns + 1;
GMAT propused_kg = mass_prior_to_burn - Sat.TotalMass;
GMAT mag_burn_kmps = 1800.0 * 9.81 * log(mass_prior_to_burn/Sat.TotalMass) / 1000;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
