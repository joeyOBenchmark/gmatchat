CubeSat_chemical_burn_n_plus.Element1 = 0.0;
CubeSat_chemical_burn_n_plus.Element2 = 0.0;
CubeSat_chemical_burn_n_plus.Element3 = 0.0;
CubeSat_chemical_burn_n_plus.DecrementMass = On;
CubeSat_chemical_burn_n_plus.Isp = 350.0;
CubeSat_chemical_burn_n_plus.GravitationalAccel = 9.81;
CubeSat_chemical_burn_n_plus.Tank = {CubeSat_ChemTank};

Create ImpulsiveBurn CubeSat_chemical_burn_n_minus;
CubeSat_chemical_burn_n_minus.CoordinateSystem = 'Local';
CubeSat_chemical_burn_n_minus.Origin = 'Earth';
CubeSat_chemical_burn_n_minus.Axes = 'VNB';
CubeSat_chemical_burn_n_minus.Element1 = 0.0;
CubeSat_chemical_burn_n_minus.Element2 = 0.0;
CubeSat_chemical_burn_n_minus.Element3 = 0.0;
CubeSat_chemical_burn_n_minus.DecrementMass = On;
CubeSat_chemical_burn_n_minus.Isp = 350.0;
CubeSat_chemical_burn_n_minus.GravitationalAccel = 9.81;
CubeSat_chemical_burn_n_minus.Tank = {CubeSat_ChemTank};

Create ImpulsiveBurn CubeSat_chemical_burn_b_plus;
CubeSat_chemical_burn_b_plus.CoordinateSystem = 'Local';
CubeSat_chemical_burn_b_plus.Origin = 'Earth';
CubeSat_chemical_burn_b_plus.Axes = 'VNB';
CubeSat_chemical_burn_b_plus.Element1 = 0.0;
CubeSat_chemical_burn_b_plus.Element2 = 0.0;
CubeSat_chemical_burn_b_plus.Element3 = 0.0;
CubeSat_chemical_burn_b_plus.DecrementMass = On;
CubeSat_chemical_burn_b_plus.Isp = 350.0;
CubeSat_chemical_burn_b_plus.GravitationalAccel = 9.81;
CubeSat_chemical_burn_b_plus.Tank = {CubeSat_ChemTank};

Create ImpulsiveBurn CubeSat_chemical_burn_b_minus;
CubeSat_chemical_burn_b_minus.CoordinateSystem = 'Local';
CubeSat_chemical_burn_b_minus.Origin = 'Earth';
CubeSat_chemical_burn_b_minus.Axes = 'VNB';
CubeSat_chemical_burn_b_minus.Element1 = 0.0;
CubeSat_chemical_burn_b_minus.Element2 = 0.0;
CubeSat_chemical_burn_b_minus.Element3 = 0.0;
CubeSat_chemical_burn_b_minus.DecrementMass = On;
CubeSat_chemical_burn_b_minus.Isp = 350.0;
CubeSat_chemical_burn_b_minus.GravitationalAccel = 9.81;
CubeSat_chemical_burn_b_minus.Tank = {CubeSat_ChemTank};

Create FiniteBurn CubeSat_chemical_fb_v_plus;
CubeSat_chemical_fb_v_plus.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';
CubeSat_chemical_fb_v_plus.Thrusters = {CubeSat_chemical_v_plus};

Create FiniteBurn CubeSat_chemical_fb_v_minus;
CubeSat_chemical_fb_v_minus.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';
CubeSat_chemical_fb_v_minus.Thrusters = {CubeSat_chemical_v_minus};

Create FiniteBurn CubeSat_chemical_fb_n_plus;
CubeSat_chemical_fb_n_plus.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';
CubeSat_chemical_fb_n_plus.Thrusters = {CubeSat_chemical_n_plus};

Create FiniteBurn CubeSat_chemical_fb_n_minus;
CubeSat_chemical_fb_n_minus.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';
CubeSat_chemical_fb_n_minus.Thrusters = {CubeSat_chemical_n_minus};

Create FiniteBurn CubeSat_chemical_fb_b_plus;
CubeSat_chemical_fb_b_plus.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';
CubeSat_chemical_fb_b_plus.Thrusters = {CubeSat_chemical_b_plus};

Create FiniteBurn CubeSat_chemical_fb_b_minus;
CubeSat_chemical_fb_b_minus.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';
CubeSat_chemical_fb_b_minus.Thrusters = {CubeSat_chemical_b_minus};

Create EphemerisFile EphemerisFile1;
EphemerisFile1.Filename = '/workspace/user_analysis/test_analysis4/sim_cubesat_leo_to_geo_hohmann/CubeSat_Ephemeris.oem';
EphemerisFile1.CoordinateSystem = 'EarthMJ2000Eq';
EphemerisFile1.StepSize = 300.0;
EphemerisFile1.UpperLeft = [ 0, 0 ];
EphemerisFile1.Size = [ 0, 0 ];
EphemerisFile1.RelativeZOrder = 0;
EphemerisFile1.Maximized = Off;
EphemerisFile1.FileFormat = 'CCSDS-OEM';
EphemerisFile1.EpochFormat = 'UTCGregorian';
EphemerisFile1.InitialEpoch = 'InitialSpacecraftEpoch';
EphemerisFile1.FinalEpoch = 'FinalSpacecraftEpoch';
EphemerisFile1.Interpolator = 'Lagrange';
EphemerisFile1.InterpolationOrder = 7;
EphemerisFile1.OutputFormat = 'LittleEndian';
EphemerisFile1.IncludeCovariance = None;
EphemerisFile1.WriteEphemeris = On;
EphemerisFile1.Spacecraft = CubeSat;

Create ReportFile BurnReport;
BurnReport.SolverIterations = 'Current';
BurnReport.UpperLeft = [ 0, 0 ];
BurnReport.Size = [ 0, 0 ];
BurnReport.RelativeZOrder = 0;
BurnReport.Maximized = Off;
BurnReport.Filename = '/workspace/user_analysis/test_analysis4/sim_cubesat_leo_to_geo_hohmann/CubeSat_BurnReport.csv';
BurnReport.Precision = 16;
BurnReport.WriteHeaders = On;
BurnReport.LeftJustify = On;
BurnReport.ZeroFill = Off;
BurnReport.FixedWidth = On;
BurnReport.Delimiter = ' ';
BurnReport.ColumnWidth = 56;
BurnReport.WriteReport = On;
BurnReport.AppendToExistingFile = Off;


%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------

Create Variable mass_prior_to_burn n_burns impulse_Ns duration_s propused_kg mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b ToleranceRMAG;
Create Variable LowerLimitRMAG;
Create String write_msg_1 write_msg_2 burn_description burn_type write_msg_3 write_msg_4 write_msg_5 write_msg_6 write_msg_7 write_msg_8;
Create String write_msg_9;

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
Global BurnReport;
GMAT mass_prior_to_burn = CubeSat.TotalMass;
GMAT n_burns = 0;
% coast(days=0.05)
write_msg_1 = '> Coast: Coast (0.05 days)';
Write write_msg_1;
Propagate 'Coast' CubeSat_Hohmann_Prop(CubeSat) {CubeSat.ElapsedDays = 0.05};
% report_state(description='LEO Initial State (500 km circular)')
write_msg_2 = '--- STATE: LEO Initial State (500 km circular) ---';
Write write_msg_2;
GMAT burn_description = 'LEO Initial State (500 km circular)';
GMAT burn_type = 'none';
GMAT impulse_Ns = 0;
GMAT duration_s = 0;
GMAT propused_kg = 0;
GMAT mag_burn_kmps = 0;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
GMAT mass_prior_to_burn = CubeSat.TotalMass;
Report BurnReport burn_description CubeSat.ElapsedDays CubeSat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg CubeSat.TotalMass CubeSat.Earth.RadPer CubeSat.Earth.RadApo CubeSat.Earth.Altitude CubeSat.EarthMJ2000Eq.INC CubeSat.EarthMJ2000Eq.RAAN CubeSat.EarthMJ2000Eq.AOP CubeSat.Earth.TA CubeSat.Earth.SMA CubeSat.Earth.ECC CubeSat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
% hohmann_transfer(target_radius=42164.170000000006, ecc=0.0)
write_msg_3 = '=== HOHMANN TRANSFER: Target radius = 42164.170000000006 km, ecc = 0.0 ===';
Write write_msg_3;
% report_state(description='Hohmann Burn 1 - LEO perigee raise to GTO')
write_msg_4 = '--- STATE: Hohmann Burn 1 - LEO perigee raise to GTO ---';
Write write_msg_4;
GMAT burn_description = 'Hohmann Burn 1 - LEO perigee raise to GTO';
GMAT burn_type = 'none';
GMAT impulse_Ns = 0;
GMAT duration_s = 0;
GMAT propused_kg = 0;
GMAT mag_burn_kmps = 0;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
GMAT mass_prior_to_burn = CubeSat.TotalMass;
Report BurnReport burn_description CubeSat.ElapsedDays CubeSat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg CubeSat.TotalMass CubeSat.Earth.RadPer CubeSat.Earth.RadApo CubeSat.Earth.Altitude CubeSat.EarthMJ2000Eq.INC CubeSat.EarthMJ2000Eq.RAAN CubeSat.EarthMJ2000Eq.AOP CubeSat.Earth.TA CubeSat.Earth.SMA CubeSat.Earth.ECC CubeSat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
GMAT ToleranceRMAG = 0.1;
GMAT LowerLimitRMAG = 42164.170000000006 - ToleranceRMAG;
Propagate 'Prop To Periapsis' CubeSat_Hohmann_Prop(CubeSat) {CubeSat.Earth.Periapsis};
If CubeSat.Earth.RadApo < LowerLimitRMAG
   Target 'Hohmann Insertion' DefaultDC {SolveMode = Solve, ExitMode = SaveAndContinue, ShowProgressWindow = true};
      Vary 'Vary Insert.V' DefaultDC(CubeSat_chemical_burn_v_plus.Element1 = 0, {Perturbation = 0.01, Lower = 0, Upper = 9e+300, MaxStep = 0.5});
      Maneuver 'Apply Insertion' CubeSat_chemical_burn_v_plus(CubeSat);
      Achieve 'Achieve RadApo' DefaultDC(CubeSat.Earth.RadApo = 42164.170000000006, {Tolerance = 0.1});
   EndTarget;
EndIf;

Propagate 'Prop To Apoapsis' CubeSat_Hohmann_Prop(CubeSat) {CubeSat.Earth.Apoapsis};
% _report_impulse_burn(description='Hohmann Transfer Insert')
write_msg_5 = '*** IMPULSE BURN: Hohmann Transfer Insert ***';
Write write_msg_5;
GMAT burn_description = 'Hohmann Transfer Insert';
GMAT burn_type = 'impulse';
GMAT mag_burn_kmps = sqrt(CubeSat_chemical_burn_v_plus.Element1^2 + CubeSat_chemical_burn_v_plus.Element2^2 + CubeSat_chemical_burn_v_plus.Element3^2);
GMAT burn_kmps_v = CubeSat_chemical_burn_v_plus.Element1;
GMAT burn_kmps_n = CubeSat_chemical_burn_v_plus.Element2;
GMAT burn_kmps_b = CubeSat_chemical_burn_v_plus.Element3;
GMAT propused_kg = mass_prior_to_burn - CubeSat.TotalMass;
GMAT duration_s = propused_kg * 9.81 * 350.0 / 5.0;
GMAT impulse_Ns = 5.0 * duration_s;
GMAT n_burns = n_burns + 1;
Report BurnReport burn_description CubeSat.ElapsedDays CubeSat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg CubeSat.TotalMass CubeSat.Earth.RadPer CubeSat.Earth.RadApo CubeSat.Earth.Altitude CubeSat.EarthMJ2000Eq.INC CubeSat.EarthMJ2000Eq.RAAN CubeSat.EarthMJ2000Eq.AOP CubeSat.Earth.TA CubeSat.Earth.SMA CubeSat.Earth.ECC CubeSat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
GMAT mass_prior_to_burn = CubeSat.TotalMass;
GMAT CubeSat_chemical_burn_v_plus.Element1 = 0;
GMAT CubeSat_chemical_burn_v_plus.Element2 = 0;
GMAT CubeSat_chemical_burn_v_plus.Element3 = 0;
Target 'Hohmann Circularization' DefaultDC {SolveMode = Solve, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary 'Vary Circ.V' DefaultDC(CubeSat_chemical_burn_v_plus.Element1 = 0, {Perturbation = 0.001, Lower = 0, Upper = 9e+300, MaxStep = 0.2});
   Maneuver 'Apply Circularization' CubeSat_chemical_burn_v_plus(CubeSat);
   Achieve 'Achieve ECC' DefaultDC(CubeSat.Earth.ECC = 0.0, {Tolerance = 0.001});
EndTarget;
% _report_impulse_burn(description='Hohmann Transfer Circ')
write_msg_6 = '*** IMPULSE BURN: Hohmann Transfer Circ ***';
Write write_msg_6;
GMAT burn_description = 'Hohmann Transfer Circ';
GMAT burn_type = 'impulse';
GMAT mag_burn_kmps = sqrt(CubeSat_chemical_burn_v_plus.Element1^2 + CubeSat_chemical_burn_v_plus.Element2^2 + CubeSat_chemical_burn_v_plus.Element3^2);
GMAT burn_kmps_v = CubeSat_chemical_burn_v_plus.Element1;
GMAT burn_kmps_n = CubeSat_chemical_burn_v_plus.Element2;
GMAT burn_kmps_b = CubeSat_chemical_burn_v_plus.Element3;
GMAT propused_kg = mass_prior_to_burn - CubeSat.TotalMass;
GMAT duration_s = propused_kg * 9.81 * 350.0 / 5.0;
GMAT impulse_Ns = 5.0 * duration_s;
GMAT n_burns = n_burns + 1;
Report BurnReport burn_description CubeSat.ElapsedDays CubeSat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg CubeSat.TotalMass CubeSat.Earth.RadPer CubeSat.Earth.RadApo CubeSat.Earth.Altitude CubeSat.EarthMJ2000Eq.INC CubeSat.EarthMJ2000Eq.RAAN CubeSat.EarthMJ2000Eq.AOP CubeSat.Earth.TA CubeSat.Earth.SMA CubeSat.Earth.ECC CubeSat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
GMAT mass_prior_to_burn = CubeSat.TotalMass;
GMAT CubeSat_chemical_burn_v_plus.Element1 = 0;
GMAT CubeSat_chemical_burn_v_plus.Element2 = 0;
GMAT CubeSat_chemical_burn_v_plus.Element3 = 0;
% coast(days=0.5)
write_msg_7 = '> Coast: Coast (0.5 days)';
Write write_msg_7;
Propagate 'Coast' CubeSat_Hohmann_Prop(CubeSat) {CubeSat.ElapsedDays = 0.5};
% report_state(description='GEO Final State (35786 km circular)')
write_msg_8 = '--- STATE: GEO Final State (35786 km circular) ---';
Write write_msg_8;
GMAT burn_description = 'GEO Final State (35786 km circular)';
GMAT burn_type = 'none';
GMAT impulse_Ns = 0;
GMAT duration_s = 0;
GMAT propused_kg = 0;
GMAT mag_burn_kmps = 0;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
GMAT mass_prior_to_burn = CubeSat.TotalMass;
Report BurnReport burn_description CubeSat.ElapsedDays CubeSat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg CubeSat.TotalMass CubeSat.Earth.RadPer CubeSat.Earth.RadApo CubeSat.Earth.Altitude CubeSat.EarthMJ2000Eq.INC CubeSat.EarthMJ2000Eq.RAAN CubeSat.EarthMJ2000Eq.AOP CubeSat.Earth.TA CubeSat.Earth.SMA CubeSat.Earth.ECC CubeSat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
% report_state(description='CubeSat Hohmann LEO to GEO complete')
write_msg_9 = '--- STATE: CubeSat Hohmann LEO to GEO complete ---';
Write write_msg_9;
GMAT burn_description = 'CubeSat Hohmann LEO to GEO complete';
GMAT burn_type = 'none';
GMAT impulse_Ns = 0;
GMAT duration_s = 0;
GMAT propused_kg = 0;
GMAT mag_burn_kmps = 0;
GMAT burn_kmps_v = 0;
GMAT burn_kmps_n = 0;
GMAT burn_kmps_b = 0;
GMAT mass_prior_to_burn = CubeSat.TotalMass;
Report BurnReport burn_description CubeSat.ElapsedDays CubeSat.ElapsedSecs burn_type n_burns impulse_Ns duration_s mass_prior_to_burn propused_kg CubeSat.TotalMass CubeSat.Earth.RadPer CubeSat.Earth.RadApo CubeSat.Earth.Altitude CubeSat.EarthMJ2000Eq.INC CubeSat.EarthMJ2000Eq.RAAN CubeSat.EarthMJ2000Eq.AOP CubeSat.Earth.TA CubeSat.Earth.SMA CubeSat.Earth.ECC CubeSat.EarthMJ2000Eq.RA mag_burn_kmps burn_kmps_v burn_kmps_n burn_kmps_b;
